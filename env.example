# Copy to .env and fill in real values. Do NOT commit .env.

# --- Database (driver async: postgresql+asyncpg) ---
# Dev outside Docker uses localhost; inside Docker compose the host is "db".
DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/tradingbot

# --- Binance Testnet (get keys at testnet.binance.vision / testnet.binancefuture.com) ---
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# --- Binance Live (ONLY fill in when actually running live; disable withdrawals, whitelist IP) ---
BINANCE_KEY=
BINANCE_SECRET=

# --- Live safety: must be =1 to allow LIVE mode ---
ENABLE_LIVE=0

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
