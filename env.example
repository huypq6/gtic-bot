# Copy thành .env và điền giá trị thật. KHÔNG commit .env.

# --- Database (driver async: postgresql+asyncpg) ---
# Dev ngoài Docker dùng localhost; trong Docker compose host là "db".
DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/tradingbot

# --- Binance Testnet (lấy tại testnet.binance.vision / testnet.binancefuture.com) ---
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# --- Binance Live (CHỈ điền khi thật sự chạy live; tắt quyền rút tiền, whitelist IP) ---
BINANCE_KEY=
BINANCE_SECRET=

# --- An toàn Live: phải =1 mới cho phép mode LIVE ---
ENABLE_LIVE=0

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
